PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

JWT_SECRET=cambiar-esto-en-produccion
JWT_EXPIRES_IN=7d

# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
STEAM_RETURN_URL=http://localhost:3001/auth/steam/return
STEAM_REALM=http://localhost:3001/

DATABASE_URL=postgres://postgres:postgres@localhost:5433/pantera_store
REDIS_URL=redis://localhost:6379

WHATSAPP_NUMBER=51900000000

# SteamID64 (separados por coma) de las cuentas que deben tener rol admin
ADMIN_STEAM_IDS=

# Permite acreditar saldo de prueba desde el panel de admin (por defecto: activo salvo en producción)
WALLET_TEST_CREDITS_ENABLED=true

# Comisión de la plataforma sobre las entradas de cada sala, en porcentaje (0-50)
ROOMS_PLATFORM_FEE_PERCENT=10

# Cómo se juegan las partidas de las salas:
#   manual = sin bot; los jugadores se organizan por fuera y un admin registra el ganador (por defecto)
#   fake   = lobby simulado, solo para desarrollo
#   steam  = bot real de Steam (todavía no implementado, ver src/modules/rooms/README.md)
MATCH_PROVIDER=manual
MATCH_JOIN_TIMEOUT_SEC=300
MATCH_POLL_INTERVAL_SEC=5

# --- Recargas y retiros reales (en producción están APAGADOS hasta que pongas PAYMENTS_ENABLED=true) ---
PAYMENTS_ENABLED=true
# Límites en CÉNTIMOS (1000 = S/ 10). Los valores por defecto son de piloto: montos chicos.
PAYMENTS_DEPOSIT_MIN_CENTS=500
PAYMENTS_DEPOSIT_MAX_CENTS=20000
PAYMENTS_DEPOSIT_DAILY_MAX_CENTS=50000
PAYMENTS_DEPOSIT_MAX_PENDING=3
PAYMENTS_WITHDRAWAL_MIN_CENTS=1000
PAYMENTS_WITHDRAWAL_MAX_CENTS=20000
PAYMENTS_WITHDRAWAL_DAILY_MAX_CENTS=50000
PAYMENTS_WITHDRAWAL_MAX_PENDING=2
# Dónde te tienen que pagar los usuarios al recargar (se muestra en la pantalla de recarga)
PAYMENTS_YAPE_NUMBER=
PAYMENTS_PLIN_NUMBER=
PAYMENTS_BANK_ACCOUNT=
PAYMENTS_ACCOUNT_HOLDER=

# Sube este número cuando cambien los Términos de Servicio: a quien aceptó una versión vieja se le vuelve a pedir.
TERMS_VERSION=1

# Horas desde que termina una partida en las que un jugador puede impugnar su resultado
DISPUTE_WINDOW_HOURS=48

# Chat general: mensajes permitidos por usuario dentro de la ventana, y largo máximo de un mensaje
CHAT_RATE_LIMIT=5
CHAT_RATE_LIMIT_WINDOW_SEC=10
CHAT_MAX_LENGTH=300

# Enlace de invitación a Discord, mostrado en /comunidad si está configurado
DISCORD_INVITE_URL=
